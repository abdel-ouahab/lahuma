<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer-times banner, collapsed: the next prayer, its time and a
     count-down the system ticks (PrayerBanner.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/pb_next_name"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pb_next_time"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:textColor="@color/prayer_banner_gold" />

    <Chronometer
        android:id="@+id/pb_countdown"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1" />
</LinearLayout>
