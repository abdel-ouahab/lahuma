# One domain for everything: the API and its media under their paths, the
# admin panel (client/dist, baked into the image) everywhere else.
{$DOMAIN} {
	encode zstd gzip

	@backend path /api/* /health /audio/* /adhan/* /public/*
	handle @backend {
		reverse_proxy backend:4000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
