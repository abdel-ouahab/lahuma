# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://lahuma:lahuma@localhost:5432/lahuma?schema=public"

# Auth
# Production: at least 32 random characters (openssl rand -hex 32); the
# server refuses to start in production with this example value.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="*"

# Media: public origin of the muezzin files. Muezzin URLs that start with
# "/" (/adhan/<slug>/v<n>/…) are resolved against it. Empty: this backend's
# own origin, as the app reached it (10.0.2.2 on the emulator, the LAN IP on
# a phone); it serves them from public/adhan (`npm run adhan:import`).
# Production: https://<the API's public origin>, or a bucket/CDN holding the
# same /adhan tree (see docs/adhan.md).
MEDIA_BASE_URL=""

# Production: reverse-proxy hops in front of the API (docker-compose.prod.yml
# sets 1 for Caddy). 0 or unset when the API is reached directly.
TRUST_PROXY=0
