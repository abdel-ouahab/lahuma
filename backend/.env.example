# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://lahuma:lahuma@localhost:5432/lahuma?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="*"

# Media: public origin of the muezzin files. Muezzin URLs that start with
# "/" (/adhan/<slug>/v<n>/…) are resolved against it. This backend serves
# them itself from public/adhan (fill it with `npm run adhan:import`):
#   Android emulator  http://10.0.2.2:4000
#   real phone        http://<this machine's LAN IP>:4000
#   production        https://<the API's public origin>, or a bucket/CDN
#                     holding the same /adhan tree (see docs/adhan.md)
MEDIA_BASE_URL="http://10.0.2.2:4000"
