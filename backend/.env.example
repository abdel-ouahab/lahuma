# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://lahuma:lahuma@localhost:5432/lahuma?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="*"

# Media (object storage): public origin of the bucket holding the adhan
# audio. Muezzin URLs that start with "/" are resolved against it.
MEDIA_BASE_URL="https://media.example.com"
