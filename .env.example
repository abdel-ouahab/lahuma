# For docker-compose.prod.yml. Copy to .env (gitignored) on the server.

# Domain whose DNS A record points at this server. Caddy gets its HTTPS
# certificate for it. The admin panel is https://<DOMAIN>/ and the mobile
# app's API_BASE_URL is https://<DOMAIN>/api.
DOMAIN=ihsan.example.com

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
